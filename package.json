{
  "name": "campus-transit-prototype",
  "version": "1.0.0",
  "private": true,
  "description": "Campus Transit — Live Disruption & Status Service",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "dev:backend": "python main.py",
    "build": "npm run build --workspace=frontend",
    "typecheck": "npm run typecheck --workspace=frontend",
    "lint": "npm run lint --workspace=frontend",
    "preview": "npm run preview --workspace=frontend",
    "test:backend": "pytest -q",
    "test:frontend": "npm run typecheck --workspace=frontend"
  }
}
