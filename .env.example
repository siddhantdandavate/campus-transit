# Campus Transit Prototype — Environment Configuration (.env.example)
# Copy to .env and configure for local deployment.
# IMPORTANT: Never commit actual .env files containing production secrets to Git.

# --- Session Management ---
SESSION_LIFETIME_HOURS=24

# --- Local Demo Account Seeding ---
# Set to 'true' in local development to automatically create demo evaluation users.
# Set to 'false' in production deployments to prevent auto-creating default accounts.
SEED_DEMO_USERS=true

# Configurable Demo Account Passwords (placeholders only)
DEMO_ADMIN_PASSWORD=AdminPass@2026
DEMO_OPERATOR_PASSWORD=OperatorPass@2026
DEMO_DRIVER_PASSWORD=DriverPass@2026

# --- Legacy Evaluation Passkey (Backward compatibility fallback) ---
OPERATOR_KEY=staff123

# --- Database & Server Configuration ---
CAMPUS_TRANSIT_DB=campus_transit.db
PORT=8000
HOST=127.0.0.1
